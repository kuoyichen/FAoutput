:ot_names
	string "MiG-21PF"
	string "MiG-21PF Fishbed-D"
	string "MIG21F.PT"
:shape
	string "m21f.SH"
:shadowShape
	string "m21f_s.SH"
:loopSound
	string "&JET1N.11K"
:secondSound
	string "&JET1A.11K"
:engineOnSound
	string "&powerup.5k"
:engineOffSound
	string "&powerdn.5k"
:hudName
	string "mig21.HUD"
:ctName
	string "f.BI"
:defaultTypeName0
	string "VIS240.SEE"
:defaultTypeName1
	string "MIG21R.SEE"
:defaultTypeName2
	string "MIG21.ECM"
:defaultTypeName3
	string "F250.GAS"
:defaultTypeName4
	string "AA2.JT"
	end
