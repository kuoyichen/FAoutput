    word 100

;---------------- movement info ----------------

    word 8190
    word 0
    word 0
    word 0
    word 0
    word 0
    word 50
    word 50
    dword ^50
    dword ^50
    dword ^0
    dword ^0
	symbol _GVProc	; utilProc

;---------------- sound info ----------------

	ptr loopSound
	ptr secondSound
    dword 0
    dword 0
    byte 1
    word 2500
    word 25
    word 20
    word 20
    word 1000
    word 0
    word 0
    word 0
    dword 0



;---------------- END OF OBJ_TYPE ----------------


;---------------- START OF NPC_TYPE ----------------

    dword $0
    dword 0
    byte 20
    byte 60
    byte 40
    word 32767
    word 0
    byte 3
	ptr hards

;---------------- END OF NPC_TYPE ----------------

:hards
