[brent's_relocatable_format]

;---------------- START OF OBJ_TYPE ----------------


;---------------- general info ----------------

    byte 7 ; structType
    word 315 ; typeSize
    word 52 ; instanceSize
	ptr ot_names
    dword $8000006 ; flags
    word $80 ; obj_class
	ptr shape
    dword 0
    dword 0
    dword 0
    word 0 ; dmgDebrisPos.x
    word 0 ; dmgDebrisPos.y
    word 0 ; dmgDebrisPos.z
    dword 0
    dword 0
    word 0 ; dstDebrisPos.x
    word 0 ; dstDebrisPos.y
    word 0 ; dstDebrisPos.z
    dword 0 ; dmgType
    dword 1956 ; year
    word 39 ; maxVisDist
    word 0 ; cameraDist
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 0 ; sigs [i]
    word 0
    word 400
    word 170
    word 230
    word 240
    word 270
    byte 30
    byte 6
    dword 55
    word 0 ; cmdBufSize

;---------------- movement info ----------------

    word 0
    word 0
    word 16380
    word -16380
    word 16380
    word 1466
    word 5866
    word 5866
    dword ^0
    dword ^0
    dword ^0
    dword $7fffff00
	symbol _PROJProc	; utilProc

;---------------- sound info ----------------

    dword 0
    dword 0
    dword 0
    dword 0
    byte 1 ; doDoppler
    word 7000 ; maxSndDist
    word 300 ; maxPlusDopplerPitch
    word 130 ; maxMinusDopplerPitch
    word 20 ; minDopplerSpeed
    word 1600 ; maxDopplerSpeed
    word 0 ; viewOffset.x
    word 0 ; viewOffset.y
    word 0 ; viewOffset.z
    dword 0



;---------------- END OF OBJ_TYPE ----------------


;---------------- START OF PROJ_TYPE ----------------

    dword $645c0
    word 1
    byte 10 ; structType
	ptr si_names
    word 0 ; weight
    byte $0 ; flags
    byte 1
    byte $0 ; flags
    byte 0
    byte 0
    byte 0
    byte 0
    byte 0
    word 32760
    word 16380
    dword ^0
    dword ^29268
    dword $8011c180
    dword $7fee3e80
    word 8190
    word 8190
    dword ^0
    dword ^13414
    dword $8011c180
    dword $7fee3e80
    byte 100
    byte 100
    byte 4
    byte 0 ; trackMaxG
    byte 0
    word 0 ; randomFirePercent
    word 0 ; offsetFirePercent
    word 0 ; offsetFireH
    word 0 ; offsetFireP
    byte 1
    byte 1
    byte 1
    byte 8
    byte 16
    byte 0 ; startupShots
    byte 0 ; hSines
    byte 0 ; hSineDegrees
    byte 0 ; vSines
    byte 0 ; vSineDegrees
    byte 21 ; maxAON
    word 5616
    word 2808
    word 0
    word 1
    word 50
    word 0
    word 0
    byte 100
    byte 200
    byte 0
    byte 0
    byte 0
    byte 0
    word 0
    word 0
    word 0
    byte 100
    byte 7
    byte 255
    byte 1
    byte 30
    byte 50
    byte 80
    byte 70
    byte 60
    byte 1
    byte 50
    byte 0
    byte 60
    byte 65
    byte 10
    byte 2
    byte 0
    byte 0
    byte 3
    word 0
    word 0 ; fuzeRadius
    byte 0
    byte 21
    byte 34
	ptr fireSound
    word 6000 ; maxSndDist
    word 30 ; freqAdj
    word 75
    word 35

;---------------- END OF PROJ_TYPE ----------------

:ot_names
	string "120mm"
	string "120mm Main Gun"
	string "M1.JT"
:shape
	string "tracer.SH"
:si_names
	string "120mm"
	string "120mm Main Gun"
	string "M1.JT"
:fireSound
	string "&cannon1.5K"
	end
