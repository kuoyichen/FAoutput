[brent's_relocatable_format]

;---------------- START OF OBJ_TYPE ----------------


;---------------- general info ----------------

    byte 7 ; structType
    word 315 ; typeSize
    word 52 ; instanceSize
	ptr ot_names
    dword $6
    word $80 ; obj_class
	ptr shape
    dword 0
    dword 0
    dword 0
    word 0 ; dmgDebrisPos.x
    word 0 ; dmgDebrisPos.y
    word 0 ; dmgDebrisPos.z
    dword 0
    dword 0
    word 0 ; dstDebrisPos.x
    word 0 ; dstDebrisPos.y
    word 0 ; dstDebrisPos.z
    dword 0 ; dmgType
    dword 1956 ; year
    word 59 ; maxVisDist
    word 0 ; cameraDist
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 0 ; sigs [i]
    word 5
    word 140
    word 35
    word 35
    word 30
    word 50
    byte 30
    byte 1
    dword 24
    word 0 ; cmdBufSize

;---------------- movement info ----------------

    word 0
    word 0
    word 16380
    word -16380
    word 16380
    word 0
    word 2786
    word 2786
    dword ^3811
    dword ^67
    dword ^0
    dword $7fffff00
	symbol _PROJProc	; utilProc

;---------------- sound info ----------------

	ptr loopSound
    dword 0
    dword 0
    dword 0
    byte 1 ; doDoppler
    word 7000 ; maxSndDist
    word 300 ; maxPlusDopplerPitch
    word 130 ; maxMinusDopplerPitch
    word 20 ; minDopplerSpeed
    word 1600 ; maxDopplerSpeed
    word 0 ; viewOffset.x
    word 0 ; viewOffset.y
    word 0 ; viewOffset.z
    dword 0



;---------------- END OF OBJ_TYPE ----------------


;---------------- START OF PROJ_TYPE ----------------

    dword $328d2
    word 1
    byte 10 ; structType
	ptr si_names
    word 0 ; weight
    byte $0 ; flags
    byte 0
    byte $0 ; flags
    byte 0
    byte 0
    byte 0
    byte 0
    byte 0
    word 16380
    word 16380
    dword ^1219
    dword ^19512
    dword $8011c180
    dword $7fee3e80
    word 8190
    word 8190
    dword ^1219
    dword ^9756
    dword $8011c180
    dword $7fee3e80
    byte 0
    byte 0
    byte 12
    byte 6 ; trackMaxG
    byte 0
    word 0 ; randomFirePercent
    word 0 ; offsetFirePercent
    word 0 ; offsetFireH
    word 0 ; offsetFireP
    byte 1
    byte 2
    byte 2
    byte 0
    byte 2
    byte 0 ; startupShots
    byte 0 ; hSines
    byte 0 ; hSineDegrees
    byte 0 ; vSines
    byte 0 ; vSineDegrees
    byte 21 ; maxAON
    word 1900
    word 0
    word 0
    word 15
    word 80
    word 1820
    word 1820
    byte 100
    byte 100
    byte 0
    byte 0
    byte 0
    byte 0
    word 546
    word 1
    word 16
    byte 100
    byte 8
    byte 4
    byte 12
    byte 2
    byte 10
    byte 45
    byte 30
    byte 25
    byte 5
    byte 25
    byte 0
    byte 35
    byte 0
    byte 15
    byte 5
    byte 0
    byte 15
    byte 4
    word 0
    word 100 ; fuzeRadius
    byte 10
    byte 15
    byte 17
	ptr fireSound
    word 6000 ; maxSndDist
    word 0 ; freqAdj
    word 400
    word 35

;---------------- END OF PROJ_TYPE ----------------

:ot_names
	string "Mk 4"
	string "MK 4 Mighty Mouse"
	string "272FFAR.JT"
:shape
	string "san11.SH"
:loopSound
	string "&missile.11k"
:si_names
	string "Mk 4"
	string "MK 4 Mighty Mouse"
	string "272FFAR.JT"
:fireSound
	string "&ltmiss.11k"
	end
