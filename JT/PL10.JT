[brent's_relocatable_format]

;---------------- START OF OBJ_TYPE ----------------


;---------------- general info ----------------

    byte 7 ; structType
    word 315 ; typeSize
    word 52 ; instanceSize
	ptr ot_names
    dword $8000007
    word $80 ; obj_class
	ptr shape
    dword 0
    dword 0
    dword 0
    word 0 ; dmgDebrisPos.x
    word 0 ; dmgDebrisPos.y
    word 0 ; dmgDebrisPos.z
    dword 0
    dword 0
    word 0 ; dstDebrisPos.x
    word 0 ; dstDebrisPos.y
    word 0 ; dstDebrisPos.z
    dword 0 ; dmgType
    dword 1985 ; year
    word 59 ; maxVisDist
    word 0 ; cameraDist
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 100 ; sigs [i]
    word 0 ; sigs [i]
    word 20
    word 185
    word 115
    word 115
    word 290
    word 255
    byte 30
    byte 8
    dword 330
    word 0 ; cmdBufSize

;---------------- movement info ----------------

    word 0
    word 0
    word 16380
    word -16380
    word 16380
    word 0
    word 1393
    word 1393
    dword ^513
    dword ^1
    dword ^0
    dword $7fffff00
	symbol _PROJProc	; utilProc

;---------------- sound info ----------------

	ptr loopSound
    dword 0
    dword 0
    dword 0
    byte 1 ; doDoppler
    word 7000 ; maxSndDist
    word 300 ; maxPlusDopplerPitch
    word 130 ; maxMinusDopplerPitch
    word 20 ; minDopplerSpeed
    word 1600 ; maxDopplerSpeed
    word 0 ; viewOffset.x
    word 0 ; viewOffset.y
    word 0 ; viewOffset.z
    dword 0



;---------------- END OF OBJ_TYPE ----------------


;---------------- START OF PROJ_TYPE ----------------

    dword $22063
    word 3
    byte 10 ; structType
	ptr si_names
    word 0 ; weight
    byte $0 ; flags
    byte 2
    byte $0 ; flags
    byte 0
    byte 0
    byte 0
    byte 0
    byte 0
    word 8190
    word 8190
    dword ^0
    dword ^102438
    dword $8011c180
    dword $7fee3e80
    word 8190
    word 16380
    dword ^0
    dword ^102438
    dword $8011c180
    dword $7fee3e80
    byte 20
    byte 25
    byte 20
    byte 5 ; trackMaxG
    byte 0
    word 0 ; randomFirePercent
    word 0 ; offsetFirePercent
    word 0 ; offsetFireH
    word 0 ; offsetFireP
    byte 1
    byte 1
    byte 1
    byte 0
    byte 32
    byte 0 ; startupShots
    byte 0 ; hSines
    byte 0 ; hSineDegrees
    byte 0 ; vSines
    byte 0 ; vSineDegrees
    byte 85 ; maxAON
    word 800
    word 950
    word 0
    word 16
    word 240
    word 728
    word 7280
    byte 100
    byte 200
    byte 40
    byte 10
    byte 25
    byte 20
    word 0
    word 0
    word 0
    byte 100
    byte 8
    byte 12
    byte 3
    byte 7
    byte 20
    byte 85
    byte 85
    byte 80
    byte 30
    byte 0
    byte 0
    byte 10
    byte 100
    byte 0
    byte 0
    byte 30
    byte 0
    byte 9
    word 2
    word 0 ; fuzeRadius
    byte 0
    byte 21
    byte 34
	ptr fireSound
    word 6000 ; maxSndDist
    word 0 ; freqAdj
    word 185
    word 35

;---------------- END OF PROJ_TYPE ----------------

:ot_names
	string "Brimstone"
	string "Brimstone x3"
	string "PL10.JT"
:shape
	string "swngr.SH"
:loopSound
	string "&missile.11k"
:si_names
	string "Brimstone"
	string "Brimstone x3"
	string "PL10.JT"
:fireSound
	string "&ashvyq.11K"
	end
